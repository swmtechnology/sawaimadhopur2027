rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.mobile is string && data.mobile.size() >= 10 &&
             data.email is string &&
             (!('createdAt' in data) || data.createdAt is number);
    }

    function isValidMessage(data) {
      return data.id is string &&
             data.senderId is string &&
             data.receiverId is string &&
             data.messageText is string && data.messageText.size() > 0 && data.messageText.size() <= 2000 &&
             data.timestamp is number &&
             data.participants is list && data.participants.size() == 2 &&
             (!('senderName' in data) || data.senderName is string) &&
             (!('receiverName' in data) || data.receiverName is string) &&
             (!('transport' in data) || data.transport is string);
    }

    function isValidChat(data) {
      return data.chatId is string &&
             data.participants is list && data.participants.size() == 2 &&
             data.lastMessageText is string && data.lastMessageText.size() <= 2000 &&
             data.lastTimestamp is number &&
             data.lastSenderId is string;
    }

    // Users directory: Authenticated users can read the community directory; users can write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || userId == ('user_' + request.auth.uid)) && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && (request.auth.uid == userId || userId == ('user_' + request.auth.uid)) && isValidUser(request.resource.data);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Messages: Only conversation participants can read and write
    match /messages/{messageId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid in resource.data.participants ||
         resource.data.senderId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        request.auth.uid in request.resource.data.participants &&
        isValidMessage(request.resource.data);
      allow update: if isAuthenticated() &&
        resource.data.senderId == request.auth.uid &&
        isValidMessage(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }

    // Chats: Only conversation participants can read/write
    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create, update: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participants &&
        isValidChat(request.resource.data);
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.participants;
    }
  }
}
